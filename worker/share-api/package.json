{
  "name": "share-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "migrate": "wrangler d1 migrations apply flickto-accounts --remote",
    "migrations": "wrangler d1 migrations list flickto-accounts --remote",
    "_comment_deploy": "Migrations run FIRST and gate the deploy: code that assumes a new column must never ship ahead of the column.",
    "deploy": "npm run migrate && wrangler deploy",
    "deploy:code-only": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9",
    "wrangler": "^3.78.10"
  }
}
